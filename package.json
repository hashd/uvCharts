{
  "name": "uvcharts",
  "version": "2.0.0-alpha.1",
  "description": "Easy yet powerful TypeScript charting library built using D3.js",
  "keywords": [
    "charts",
    "d3",
    "typescript",
    "visualization",
    "bar",
    "line",
    "pie",
    "donut",
    "area",
    "waterfall"
  ],
  "homepage": "https://imaginea.github.io/uvCharts",
  "bugs": {
    "url": "https://github.com/imaginea/uvCharts/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kiran Danduprolu",
    "email": "gitk@danduprolu.com",
    "url": "http://kiran.danduprolu.com"
  },
  "type": "module",
  "main": "./dist/uvcharts.umd.cjs",
  "module": "./dist/uvcharts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/uvcharts.js",
      "require": "./dist/uvcharts.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-color": "^3.1.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "d3-color": "^3.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "^23.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1"
  },
  "peerDependencies": {
    "d3": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "d3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
